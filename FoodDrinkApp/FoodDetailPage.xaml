<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FoodDrinkApp"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Details"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D0D0D}">

    <ContentPage.Resources>
        <Color x:Key="PrimaryColor">#7B2CBF</Color>
        <Color x:Key="SecondaryColor">#9D4EDD</Color>
        <Color x:Key="AccentColor">#FF6B6B</Color>
        <local:ProteinToWidthConverter x:Key="ProteinToWidthConverter" />
        <local:CarbsToWidthConverter x:Key="CarbsToWidthConverter" />
        <local:FatToWidthConverter x:Key="FatToWidthConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="12">

            <!-- Top header image area -->
            <Border HeightRequest="200"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    Opacity="0.8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,24,24" />
                </Border.StrokeShape>
            </Border>

            <!-- Main content area -->
            <VerticalStackLayout Padding="20,16,20,24" Spacing="20">

                <!-- Name and Calories -->
                <Grid ColumnDefinitions="*,Auto" RowSpacing="8">
                    <Label x:Name="NameLabel"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#F8F9FA}" />

                    <Label Grid.Column="1"
                           x:Name="CaloriesLabel"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentColor}" />

                    <Label Grid.Row="1"
                           Grid.ColumnSpan="2"
                           x:Name="CategoryLabel"
                           FontSize="14"
                           TextColor="{StaticResource PrimaryColor}" />
                </Grid>

                <!-- Separator -->
                <BoxView HeightRequest="1" 
                         Color="{AppThemeBinding Light=#E9ECEF, Dark=#2C2C3A}" />

                <!-- Nutrition Breakdown -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nutrition Breakdown"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#F8F9FA}" />

                    <!-- Protein -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Text="🥩" FontSize="14" />
                        <Label Text="Protein" FontSize="13" TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" />
                        <Label x:Name="ProteinValueLabel" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212529, Dark=#F8F9FA}" />
                    </Grid>
                    <Border HeightRequest="6" BackgroundColor="#E9ECEF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Border WidthRequest="{Binding Protein, Converter={StaticResource ProteinToWidthConverter}}"
                                BackgroundColor="#4ECDC4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3" />
                            </Border.StrokeShape>
                        </Border>
                    </Border>

                    <!-- Carbs -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,8,0,0">
                        <Label Text="🍚" FontSize="14" />
                        <Label Text="Carbs" FontSize="13" TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" />
                        <Label x:Name="CarbsValueLabel" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212529, Dark=#F8F9FA}" />
                    </Grid>
                    <Border HeightRequest="6" BackgroundColor="#E9ECEF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Border WidthRequest="{Binding Carbs, Converter={StaticResource CarbsToWidthConverter}}"
                                BackgroundColor="#2E86AB">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3" />
                            </Border.StrokeShape>
                        </Border>
                    </Border>

                    <!-- Fat -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,8,0,0">
                        <Label Text="🧈" FontSize="14" />
                        <Label Text="Fat" FontSize="13" TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" />
                        <Label x:Name="FatValueLabel" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212529, Dark=#F8F9FA}" />
                    </Grid>
                    <Border HeightRequest="6" BackgroundColor="#E9ECEF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Border WidthRequest="{Binding Fat, Converter={StaticResource FatToWidthConverter}}"
                                BackgroundColor="#E05A5A">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3" />
                            </Border.StrokeShape>
                        </Border>
                    </Border>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="About"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#F8F9FA}" />
                    <Label x:Name="DescriptionLabel"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" />
                </VerticalStackLayout>

                <!-- Allergy Info -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="⚠️ Allergy Info"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentColor}" />
                    <Label x:Name="AllergyLabel"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" />
                </VerticalStackLayout>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                    <Button Text="🔊 Read"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            TextColor="#FFFFFF"
                            CornerRadius="25"
                            HeightRequest="44"
                            Clicked="OnSpeakClicked" />
                    <Button Grid.Column="1"
                            Text="⏹️ Stop"
                            BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E2E}"
                            TextColor="{StaticResource PrimaryColor}"
                            BorderWidth="1"
                            BorderColor="{StaticResource PrimaryColor}"
                            CornerRadius="25"
                            HeightRequest="44"
                            Clicked="OnStopSpeechClicked" />
                </Grid>

                <Button Text="📳 Vibrate"
                        BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E2E}"
                        TextColor="{StaticResource AccentColor}"
                        BorderWidth="1"
                        BorderColor="{StaticResource AccentColor}"
                        CornerRadius="25"
                        HeightRequest="44"
                        Clicked="OnVibrateClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>