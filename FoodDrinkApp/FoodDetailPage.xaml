<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FoodDrinkApp"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Details"
             BackgroundColor="{AppThemeBinding Light=#F4FAF5, Dark=#0D1B2A}">

    <ContentPage.Resources>
        <Color x:Key="PrimaryGreen">#2D6A4F</Color>
        <Color x:Key="LightGreen">#40916C</Color>
        <Color x:Key="Mint">#52B788</Color>
        <Color x:Key="Warning">#E76F51</Color>
        <local:ProteinToWidthConverter x:Key="ProteinToWidthConverter" />
        <local:CarbsToWidthConverter x:Key="CarbsToWidthConverter" />
        <local:FatToWidthConverter x:Key="FatToWidthConverter" />
        <local:FiberToWidthConverter x:Key="FiberToWidthConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border BackgroundColor="{StaticResource PrimaryGreen}"
                    Padding="20,40,20,30">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,30,30" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="NameLabel"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center" />
                    <Label x:Name="CategoryLabel"
                           FontSize="14"
                           TextColor="#D8F3DC"
                           HorizontalOptions="Center" />
                    <Label x:Name="CaloriesLabel"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2D3C}"
                    Margin="20"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Nutrition Facts"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreen}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Protein" FontSize="11" TextColor="#6C757D" />
                            <Label x:Name="ProteinValueLabel" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreen}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Carbs" FontSize="11" TextColor="#6C757D" />
                            <Label x:Name="CarbsValueLabel" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreen}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="Fat" FontSize="11" TextColor="#6C757D" />
                            <Label x:Name="FatValueLabel" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryGreen}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E9ECEF" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Fiber" FontSize="13" TextColor="#6C757D" />
                            <Label x:Name="FiberValueLabel" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LightGreen}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Sugar" FontSize="13" TextColor="#6C757D" />
                            <Label x:Name="SugarValueLabel" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Sodium" FontSize="13" TextColor="#6C757D" />
                            <Label x:Name="SodiumValueLabel" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LightGreen}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Vitamin C" FontSize="13" TextColor="#6C757D" />
                            <Label x:Name="VitaminCValueLabel" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LightGreen}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2D3C}"
                    Margin="20"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Description"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreen}" />
                    <Label x:Name="DescriptionLabel"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#6C757D, Dark=#A8DADC}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FFF5F0, Dark=#2D1B1A}"
                    Margin="20,0,20,20"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="⚠️ Allergy Information"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Warning}" />
                    <Label x:Name="AllergyLabel"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#E76F51, Dark=#F4A261}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="20,0,20,20">
                <Button Text="🔊 Read"
                        BackgroundColor="{StaticResource PrimaryGreen}"
                        TextColor="#FFFFFF"
                        CornerRadius="25"
                        HeightRequest="48"
                        Clicked="OnSpeakClicked" />
                <Button Grid.Column="1"
                        Text="⏹️ Stop"
                        BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B2D3C}"
                        TextColor="{StaticResource PrimaryGreen}"
                        BorderWidth="1"
                        BorderColor="{StaticResource PrimaryGreen}"
                        CornerRadius="25"
                        HeightRequest="48"
                        Clicked="OnStopSpeechClicked" />
            </Grid>

            <Button Text="📳 Vibrate"
                    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1B2D3C}"
                    TextColor="{StaticResource Warning}"
                    BorderWidth="1"
                    BorderColor="{StaticResource Warning}"
                    CornerRadius="25"
                    HeightRequest="48"
                    Margin="20,0,20,40"
                    Clicked="OnVibrateClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>