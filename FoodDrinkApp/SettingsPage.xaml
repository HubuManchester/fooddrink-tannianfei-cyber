<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#0F0F1A}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Header -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Accessibility"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#FFFFFF}" />
                    <Label Text="Large text and theme preferences"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </Border>

            <!-- Theme Selection -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333344}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Theme Mode"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#2E86AB" />
                    <Picker x:Name="ThemePicker"
                            Title="Choose app theme"
                            SelectedIndexChanged="OnThemeChanged">
                        <Picker.Items>
                            <x:String>Use system theme</x:String>
                            <x:String>Light theme</x:String>
                            <x:String>Dark theme</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Large Text Toggle -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333344}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Large Text Mode"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#4ECDC4" />
                        <Label Text="Increase text size for better readability"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    </VerticalStackLayout>
                    <Switch x:Name="LargeTextSwitch"
                            Grid.Column="1"
                            Toggled="OnLargeTextToggled" />
                </Grid>
            </Border>

            <!-- Preview Panel -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333344}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="LargeTextPreviewTitle"
                           Text="Large text preview"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2E86AB" />
                    <Label x:Name="LargeTextPreviewBody"
                           Text="When enabled, this text and the rest of the page become visibly larger"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </Border>

            <!-- Status -->
            <Label x:Name="SettingsStatusLabel"
                   Text="Settings ready"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#4ECDC4"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0" />

            <BoxView HeightRequest="20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>