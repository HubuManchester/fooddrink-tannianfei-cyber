<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.HardwarePage"
             Title="Hardware Demo"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#0F0F1A}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Header -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Hardware Features"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#FFFFFF}" />
                    <Label Text="Camera, location, speech, vibration, and haptic feedback"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </Border>

            <!-- Camera Section -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333344}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Camera" FontSize="16" FontAttributes="Bold" TextColor="#2E86AB" />
                            <Label Text="Capture food photo" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Take Photo"
                                BackgroundColor="#2E86AB"
                                TextColor="#FFFFFF"
                                CornerRadius="8"
                                Clicked="OnTakePhotoClicked" />
                    </Grid>
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444455}"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252540}"
                            HeightRequest="200">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Image x:Name="FoodPhoto"
                               Aspect="AspectFill"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Location Section -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333344}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Location" FontSize="16" FontAttributes="Bold" TextColor="#2E86AB" />
                            <Label Text="Get current position" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Get Location"
                                BackgroundColor="#2E86AB"
                                TextColor="#FFFFFF"
                                CornerRadius="8"
                                Clicked="OnGetLocationClicked" />
                    </Grid>
                    <Label x:Name="LocationLabel"
                           Text="Location not captured yet"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#1A1A2E, Dark=#FFFFFF}" />
                    <Label x:Name="CoordinateLabel"
                           Text="Coordinates will appear here"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />
                </VerticalStackLayout>
            </Border>

            <!-- Speech Section -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read Help"
                        BackgroundColor="#4ECDC4"
                        TextColor="#FFFFFF"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnReadHelpClicked" />
                <Button Grid.Column="1"
                        Text="Stop"
                        BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333344}"
                        TextColor="#2E86AB"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnStopSpeechClicked" />
            </Grid>

            <!-- Haptic Section -->
            <Button Text="Test Haptic Feedback"
                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333344}"
                    TextColor="#E05A5A"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnFeedbackClicked" />

            <!-- Status Panel -->
            <Border StrokeThickness="1"
                    Stroke="#E05A5A"
                    BackgroundColor="{AppThemeBinding Light=#FFF5F5, Dark=#331111}"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="HardwareStatusLabel"
                           Text="Ready"
                           FontAttributes="Bold"
                           TextColor="#E05A5A" />
                    <Label x:Name="FeedbackCountLabel"
                           Text="Haptic feedback tests: 0"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>