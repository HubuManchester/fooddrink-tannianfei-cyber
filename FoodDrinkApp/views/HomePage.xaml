<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.Views.HomePage"
             Title="Log"
             BackgroundColor="{AppThemeBinding Light=#F4FAF5, Dark=#0D1B2A}">

    <Grid RowDefinitions="Auto,Auto,*">

        <VerticalStackLayout Padding="20,20,20,8" Spacing="2"
                             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2D3C}">
            <Label Text="VitaLog"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#2D6A4F, Dark=#95D5B2}" />
            <Label Text="Track what you eat"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#6C757D, Dark=#A8DADC}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" Padding="16,0,16,12" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2D3C}"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <SearchBar x:Name="SearchFoodBar"
                           Placeholder="Search meals..."
                           TextChanged="OnSearchTextChanged"
                           SearchButtonPressed="OnSearchButtonPressed"
                           TextColor="{AppThemeBinding Light=#1B4332, Dark=#F8F9FA}"
                           PlaceholderColor="{AppThemeBinding Light=#A8DADC, Dark=#6C757D}"
                           BackgroundColor="Transparent" />
            </Border>

            <Button Grid.Column="1"
                    Text="+"
                    BackgroundColor="#2D6A4F"
                    TextColor="#FFFFFF"
                    FontSize="24"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    Clicked="OnAddClicked" />
        </Grid>

        <RefreshView Grid.Row="2" x:Name="FoodRefreshView" Refreshing="OnRefreshing"
                     BackgroundColor="{AppThemeBinding Light=#F4FAF5, Dark=#0D1B2A}">
            <CollectionView x:Name="FoodCollection"
                            SelectionMode="None"
                            EmptyView="No meals found"
                            Margin="12">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodEntry">
                        <Border StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2D3C}"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#20000000" Offset="0,2" Radius="6" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">

                                <Border HeightRequest="120"
                                        BackgroundColor="#E8F5E9"
                                        Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16,16,0,0" />
                                    </Border.StrokeShape>
                                    <Label Text="🍽️"
                                           FontSize="48"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Row="1" Padding="12,10,12,8" Spacing="6">
                                    <Label Text="{Binding Name}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1B4332, Dark=#F8F9FA}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Category}"
                                           FontSize="11"
                                           TextColor="#40916C" />
                                    <Label Text="{Binding CaloriesLabel}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2D6A4F" />
                                    <Label Text="{Binding MacroSummary}"
                                           FontSize="10"
                                           TextColor="{AppThemeBinding Light=#6C757D, Dark=#A8DADC}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <Button Grid.Row="2"
                                        Text="View"
                                        BackgroundColor="Transparent"
                                        TextColor="#2D6A4F"
                                        FontSize="12"
                                        CornerRadius="0"
                                        HeightRequest="40"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnDetailsClicked"
                                        Margin="12,0,12,8" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>