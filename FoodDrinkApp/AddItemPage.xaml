<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.AddItemPage"
             Title="New Entry"
             BackgroundColor="{AppThemeBinding Light=#F4FAF5, Dark=#0D1B2A}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Add New Food"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#2D6A4F" />

            <Label Text="Fill in the details below"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#6C757D, Dark=#A8DADC}"
                   Margin="0,-4,0,12" />

            <Entry x:Name="NameEntry"
                   Placeholder="Food name *"
                   FontSize="15" />

            <Picker x:Name="CategoryPicker"
                    Title="Select category *"
                    FontSize="15">
                <Picker.Items>
                    <x:String>Breakfast</x:String>
                    <x:String>Lunch</x:String>
                    <x:String>Dinner</x:String>
                    <x:String>Snack</x:String>
                    <x:String>Drink</x:String>
                </Picker.Items>
            </Picker>

            <Editor x:Name="DescriptionEditor"
                    Placeholder="Description *"
                    AutoSize="TextChanges"
                    HeightRequest="80"
                    FontSize="14" />

            <BoxView HeightRequest="1" 
                     Color="{AppThemeBinding Light=#E9ECEF, Dark=#2C2C3A}"
                     Margin="0,8,0,8" />

            <Label Text="Nutritional Values"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#2D6A4F" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Entry x:Name="CaloriesEntry"
                       Placeholder="Calories (kcal) *"
                       Keyboard="Numeric"
                       FontSize="14" />
                <Entry x:Name="ProteinEntry"
                       Grid.Column="1"
                       Placeholder="Protein (g)"
                       Keyboard="Numeric"
                       FontSize="14" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Entry x:Name="CarbsEntry"
                       Placeholder="Carbs (g)"
                       Keyboard="Numeric"
                       FontSize="14" />
                <Entry x:Name="FatEntry"
                       Grid.Column="1"
                       Placeholder="Fat (g)"
                       Keyboard="Numeric"
                       FontSize="14" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Entry x:Name="FiberEntry"
                       Placeholder="Fiber (g)"
                       Keyboard="Numeric"
                       FontSize="14" />
                <Entry x:Name="SugarEntry"
                       Grid.Column="1"
                       Placeholder="Sugar (g)"
                       Keyboard="Numeric"
                       FontSize="14" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Entry x:Name="SodiumEntry"
                       Placeholder="Sodium (mg)"
                       Keyboard="Numeric"
                       FontSize="14" />
                <Entry x:Name="VitaminCEntry"
                       Grid.Column="1"
                       Placeholder="Vitamin C (mg)"
                       Keyboard="Numeric"
                       FontSize="14" />
            </Grid>

            <Entry x:Name="AllergyEntry"
                   Placeholder="Allergy notes (optional)"
                   FontSize="14" />

            <Border x:Name="ValidationPanel"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light=#FFF5F0, Dark=#2D1B1A}"
                    Padding="12"
                    Margin="0,8,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label x:Name="ValidationLabel"
                       TextColor="#E76F51"
                       FontSize="12" />
            </Border>

            <Button Text="Save Entry"
                    BackgroundColor="#2D6A4F"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="48"
                    Clicked="OnSaveClicked"
                    Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
