<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodDrinkApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoodDrinkApp"
    Title="FoodTracker"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}"
    Shell.ForegroundColor="{AppThemeBinding Light=#1E1E2E, Dark=#EEEEEE}"
    Shell.TitleColor="{AppThemeBinding Light=#1E1E2E, Dark=#EEEEEE}"
    Shell.UnselectedColor="{AppThemeBinding Light=#999999, Dark=#666666}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light=#7B2CBF, Dark=#9D4EDD}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#7B2CBF, Dark=#9D4EDD}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#999999, Dark=#666666}">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Device"
            ContentTemplate="{DataTemplate local:HardwarePage}"
            Route="HardwarePage" />
        <ShellContent
            Title="More"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>
</Shell>