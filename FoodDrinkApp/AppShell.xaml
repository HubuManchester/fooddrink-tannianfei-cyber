<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodDrinkApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoodDrinkApp"
    Title="VitaLog"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0D1B2A}"
    Shell.ForegroundColor="{AppThemeBinding Light=#1B4332, Dark=#D8F3DC}"
    Shell.TitleColor="{AppThemeBinding Light=#2D6A4F, Dark=#95D5B2}"
    Shell.UnselectedColor="{AppThemeBinding Light=#A8DADC, Dark=#457B9D}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0D1B2A}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light=#2D6A4F, Dark=#95D5B2}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#2D6A4F, Dark=#95D5B2}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#A8DADC, Dark=#457B9D}">

    <TabBar>
        <ShellContent
            Title="Log"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Scan"
            ContentTemplate="{DataTemplate local:HardwarePage}"
            Route="HardwarePage" />
        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>
</Shell>