<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.MainPage"
             Title="Home"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D0D0D}">

    <ContentPage.Resources>
        <Color x:Key="PrimaryColor">#7B2CBF</Color>
        <Color x:Key="SecondaryColor">#9D4EDD</Color>
        <Color x:Key="AccentColor">#FF6B6B</Color>
        <Color x:Key="CardBgLight">#FFFFFF</Color>
        <Color x:Key="CardBgDark">#1E1E2E</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header Section -->
        <VerticalStackLayout Padding="20,16,20,8" Spacing="4"
                             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">
            <Label Text="Hello!"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}" />
            <Label Text="Track your daily nutrition"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" />
        </VerticalStackLayout>

        <!-- Search Bar Section -->
        <Grid Grid.Row="1" Padding="16,0,16,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E9ECEF, Dark=#2C2C3A}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25" />
                </Border.StrokeShape>
                <SearchBar x:Name="SearchFoodBar"
                           Placeholder="Find food or drink..."
                           TextChanged="OnSearchTextChanged"
                           SearchButtonPressed="OnSearchButtonPressed"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#F8F9FA}"
                           PlaceholderColor="{AppThemeBinding Light=#ADB5BD, Dark=#6C757D}"
                           BackgroundColor="Transparent"
                           CancelButtonColor="{StaticResource PrimaryColor}" />
            </Border>

            <Button Grid.Column="1"
                    Text="+"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="#FFFFFF"
                    FontSize="22"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Clicked="OnAddClicked"
                    SemanticProperties.Hint="Add new item" />
        </Grid>

        <!-- Food List Section -->
        <RefreshView Grid.Row="2" x:Name="FoodRefreshView" Refreshing="OnRefreshing"
                     BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0D0D0D}">
            <CollectionView x:Name="FoodCollection"
                            SelectionMode="None"
                            EmptyView="No matching records"
                            Margin="12,0,12,16">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodItem">
                        <Grid Padding="0,0,0,10">
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E9ECEF, Dark=#2C2C3A}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
                                    Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="8"
                                      ColumnSpacing="12">

                                    <Label Text="{Binding Name}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#212529, Dark=#F8F9FA}" />

                                    <Label Grid.Column="1"
                                           Text="{Binding CaloriesLabel}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource AccentColor}" />

                                    <Border Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light=#F0E6FF, Dark=#2D1B4E}"
                                            Padding="8,4"
                                            HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Category}"
                                               FontSize="11"
                                               TextColor="{StaticResource PrimaryColor}" />
                                    </Border>

                                    <Label Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                    <Label Grid.Row="3"
                                           Text="{Binding MacroSummary}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" />

                                    <Button Grid.Row="3"
                                            Grid.Column="1"
                                            Text="View"
                                            Padding="16,6"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource PrimaryColor}"
                                            FontSize="13"
                                            CommandParameter="{Binding Id}"
                                            Clicked="OnDetailsClicked"
                                            BorderWidth="1"
                                            BorderColor="{StaticResource PrimaryColor}"
                                            CornerRadius="20" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>